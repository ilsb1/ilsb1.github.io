# Settings for the writing app (npm run dev:desk here, Vercel when hosted).
#
# Optional on this computer. The writing app works without these:
# sign-in codes are shown on the page, drafts are kept in server/data,
# and Publish saves the post into public/blogs so the site on
# npm run dev shows it.
#
# On Vercel all of these are required, and are set in the project's
# Environment Variables settings rather than in a file.

# A long random string (at least 32 characters on Vercel).
AUTH_SECRET=

# The Gmail account that sends sign-in codes, and an app password for it
# (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# A fine-grained GitHub token with "Contents: Read and write" on this repository only.
GITHUB_TOKEN=
GITHUB_REPO=ilsb1/ilsb1.github.io
GITHUB_BRANCH=main

# Drafts and sign-in codes. Added automatically when an Upstash Redis
# database is connected to the Vercel project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Where the "View blog" links point. Defaults to https://ilsb1.github.io.
# Only needed if the public site moves to its own domain.
VITE_BLOG_URL=
