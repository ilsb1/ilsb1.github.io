# Optional. The writing desk works without these.
# On this computer, sign-in codes are shown on the page, and Publish
# saves the piece into public/blogs so you can preview it.
#
# Add these when you want codes to arrive by email, and Publish to
# update the GitHub repository (which then updates the public website).

# A long random string. If you leave this empty, one is created in server/data.
AUTH_SECRET=

# From https://resend.com. MAIL_FROM must be an address Resend is allowed to send from.
RESEND_API_KEY=
MAIL_FROM=

# A GitHub token that can edit files in this repository.
GITHUB_TOKEN=
GITHUB_REPO=ilsb1/ilsb1.github.io
GITHUB_BRANCH=main
